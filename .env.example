# Database - Vercel Neon PostgreSQL
# Get this from your Neon dashboard: https://neon.tech
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Payload CMS
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=your-secret-key-here-change-in-production

# Next.js
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob Storage (optional - for media uploads)
# Automatically set when using Vercel Blob integration
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token
