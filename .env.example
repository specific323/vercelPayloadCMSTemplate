# Database - Vercel Neon PostgreSQL
# Vercel Marketplace 整合後會自動注入以下兩個變數：
# DATABASE_URL         → Pooled 連線 (PgBouncer)，供 runtime 查詢使用
# DATABASE_URL_UNPOOLED → Direct 連線，供 migration 使用
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Payload CMS
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=your-secret-key-here-change-in-production

# Next.js
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob Storage (optional - for media uploads)
# Automatically set when using Vercel Blob integration
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token
